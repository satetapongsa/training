# AI Vision Training Studio Environment Configuration
PROJECT_NAME="AI Vision Training Studio"
APP_ENV=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite+aiosqlite:///./data/studio.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_vision_studio

# Storage Paths
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATASET_DIR=./data/datasets
RUNS_DIR=./data/runs
MODELS_DIR=./data/models

# Security & Uploads
MAX_UPLOAD_SIZE_MB=500
ALLOWED_IMAGE_EXTENSIONS=["jpg","jpeg","png","webp","bmp","tiff","tif"]
SECRET_KEY=dev-secret-key-change-in-production-32bytes-min

# Compute & Workers
DEVICE=auto
MAX_CONCURRENT_JOBS=1
WORKER_POLL_INTERVAL_SEC=1.0
