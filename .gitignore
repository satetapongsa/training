# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtualenv
.env
.env.local
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Python packaging & builds
build/
dist/
*.egg-info/
.eggs/

# SQLite Database & Storage Data
data/*.db
data/*.sqlite3
data/studio.db
data/uploads/*
!data/uploads/.gitkeep
data/datasets/*
!data/datasets/.gitkeep
data/runs/*
!data/runs/.gitkeep
data/models/*
!data/models/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Model weights (prevent exceeding GitHub 100MB limit)
*.pt
*.pth
*.onnx
*.engine
*.tflite

# Frontend (Node / React / Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
